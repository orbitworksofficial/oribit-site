# Copy to .env.local and fill in. .env* is gitignored.
#
# NEXT_PUBLIC_* values are inlined at BUILD time — changing one on a running
# server does nothing until you rebuild and redeploy.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Atlas → Connect → Drivers → Node.js.
# Remember to allow your server's IP under Atlas → Network Access.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Optional; defaults to "orbitworks".
MONGODB_DB="orbitworks"

# --- Admin sessions -------------------------------------------------------
# Signs the session JWT. At least 32 characters, and NOT the value below.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Analytics ------------------------------------------------------------
# GA4 measurement ID. Leave blank to ship no analytics at all.
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# --- Site -----------------------------------------------------------------
# Canonical origin. Feeds sitemap.xml, robots.txt, canonicals and OG URLs.
NEXT_PUBLIC_SITE_URL="https://orb-itworks.com"

# --- Image uploads --------------------------------------------------------
# Cloudinary. REQUIRED on serverless hosts (Vercel, Netlify): their filesystem
# is read-only, so uploads to public/uploads fail or vanish on redeploy.
#
# Leave all of these blank to store uploads on local disk instead — correct for
# `npm run dev` and for a VPS with a persistent volume.
#
# Copy the "API Environment variable" value from the Cloudinary dashboard:
CLOUDINARY_URL=""

# Or set the three parts individually, if your host's variable editor mangles
# the URL form. The URL above takes precedence when present.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Folder that uploads are filed under inside the account. Optional.
CLOUDINARY_FOLDER="orbitworks/blog"
