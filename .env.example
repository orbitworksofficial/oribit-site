# Copy to .env.local and fill in. .env* is gitignored.
#
# NEXT_PUBLIC_* values are inlined at BUILD time — changing one on a running
# server does nothing until you rebuild and redeploy.

# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string. Atlas → Connect → Drivers → Node.js.
# Remember to allow your server's IP under Atlas → Network Access.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
# Optional; defaults to "orbitworks".
MONGODB_DB="orbitworks"

# --- Admin sessions -------------------------------------------------------
# Signs the session JWT. At least 32 characters, and NOT the value below.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Analytics ------------------------------------------------------------
# Two modes. Set ONE of them — setting both is not possible by design, because
# GTM would load its own GA4 tag alongside the direct one and every pageview
# would be counted twice. NEXT_PUBLIC_GTM_ID wins when both are present.
#
# 1. Google Tag Manager (recommended). GA4, Meta Pixel, LinkedIn, conversion
#    tags — all added from GTM's dashboard with no code change or redeploy.
#    Find the ID at the top of the GTM workspace: GTM-XXXXXXX.
NEXT_PUBLIC_GTM_ID=""

# 2. GA4 on its own, loaded directly. Used only when GTM_ID above is blank.
#    Leave both blank to ship no analytics at all (the default for dev).
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# --- Site -----------------------------------------------------------------
# Canonical origin. Feeds sitemap.xml, robots.txt, canonicals and OG URLs.
NEXT_PUBLIC_SITE_URL="https://orb-itworks.com"

# --- Image uploads --------------------------------------------------------
# Cloudinary. REQUIRED on serverless hosts (Vercel, Netlify): their filesystem
# is read-only, so uploads to public/uploads fail or vanish on redeploy.
#
# Leave all of these blank to store uploads on local disk instead — correct for
# `npm run dev` and for a VPS with a persistent volume.
#
# IMPORTANT on deploys: .env* is gitignored, so .env.local does NOT travel with
# the code. These have to be set in the SERVER's own environment (the host's
# panel, systemd unit, Docker env, or a .env.local created on the box). Miss
# that and uploads still appear to work while quietly landing on disk as
# /uploads/… paths instead of Cloudinary URLs — the app now refuses the upload
# in production rather than letting that happen silently.
#
# If the server genuinely has a persistent disk and you want uploads stored on
# it, set ALLOW_LOCAL_UPLOADS=1 instead of the Cloudinary values below.
#
# Copy the "API Environment variable" value from the Cloudinary dashboard:
CLOUDINARY_URL=""

# Or set the three parts individually, if your host's variable editor mangles
# the URL form. The URL above takes precedence when present.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Folder that uploads are filed under inside the account. Optional.
CLOUDINARY_FOLDER="orbitworks/blog"
